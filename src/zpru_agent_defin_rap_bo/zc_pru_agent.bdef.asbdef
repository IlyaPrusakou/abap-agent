projection implementation in class ZBP_C_PRU_AGENT unique;
strict ( 2 );
extensible;
use draft;
use side effects;
define behavior for ZC_PRU_AGENT alias Agent
extensible
use etag
{
  use create;
  use update;
  use delete;

  use association _tool { create; with draft; }

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;
  use action changeDecisionEngine;
  use action changeShortMemoryProvider;
  use action changeLongMemoryProvider;
  use action changeSystemPromptProvider ;
  use action changeAgentMapper ;
  use action changeAgentStatus ;
  use action changeAgentInfoProvider ;

}


define behavior for ZC_PRU_AGENT_TOOL alias AgentTool
extensible
{

  use update;
  use delete;

  use association _agent { with draft; }

  use action changeToolProvider;
  use action changeToolSchemaProvider;
  use action changeToolInfoProvider;
  use action changeStepType;

}